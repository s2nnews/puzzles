# Copy to .env and fill in. .env is gitignored — keys never get committed.
SHOPIFY_STORE=premiumpuzzlesau.myshopify.com
# Preferred: Dev Dashboard app credentials (exchanged for a 24h Admin token
# on every run via the client credentials grant). The app needs read_orders +
# read_reports scopes and must be installed on the store.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative: a permanent Admin API token (legacy custom app, shpat_...).
# Used only if the client credentials above are blank.
SHOPIFY_TOKEN=
OMNISEND_API_KEY=
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Porter blend export (Meta Ads + GA4 + Google Ads on one date-keyed row).
# A local path or a published-CSV URL. Defaults to dashboard/porter_feed.csv.
# Header: date,meta_spend,meta_conv_value,meta_clicks,sessions,cart_adds,
#         checkouts,purchases,google_spend,google_conv_value,google_clicks
PORTER_CSV=
# How many days back to build (default 120)
DAYS=120
