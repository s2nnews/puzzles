# Copy to .env and fill in. .env is gitignored — keys never get committed.
SHOPIFY_STORE=premiumpuzzlesau.myshopify.com
SHOPIFY_TOKEN=shpat_...            # Admin API token, needs read_orders + read_reports
OMNISEND_API_KEY=
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Optional: Porter → Sheets/CSV export of Meta (columns: date,spend,conv_value)
META_CSV=
# How many days back to build (default 120)
DAYS=120
